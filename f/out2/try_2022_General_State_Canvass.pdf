/* ________________________________________________________________________ */
/** CSS used only on SOS main site to change some defaults (drupal or bootstrap) **/
/* sos replace */
body { background: #efefef; }

/* search icon */
.block-views-exposed-filter-blocksearch-page-1.az-exposed-search .content.search-wrapper .search-icon i { padding: 10px; }
.block-views-exposed-filter-blocksearch-page-1.az-exposed-search .content.search-wrapper .search-form-wrapper .search-form .form-row .js-form-item .form-control { color: #fff; }

.node--type-page .node__content ._none .container { /* background:#fff;  */ /* box-shadow:-5px 6px 10px #888;  */ }
.node--type-page .node__content ._none .container:nth-child(odd), .node--type-page .node__content ._none .container:nth-child(even) { /* box-shadow:none;  */ }

/* hiding the text of the site name */
.navbar .navbar-brand .navbar-brand-name { display: none !important; }

/* if navbar header is dark */
.navbar div .navbar-toggler .navbar-toggler-icon::after { color: #fff; }

/* sos replace towards top with navigation*/
/* if navbar header is dark */
.block.block-menu.navigation.menu--main .nav.navbar-nav .nav-item .dropdown-menu .dropdown-item { color: #fff; }
.block.block-menu.navigation.menu--main .nav.navbar-nav .nav-item .dropdown-menu .dropdown-item .caret { color: #caa451; }
