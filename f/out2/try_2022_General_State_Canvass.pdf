.spinner { /* -webkit-animation:spin 2s linear infinite; */ animation: spin 5s linear infinite; }

/* @-webkit-keyframes spin { */
/* 0% { -webkit-transform:rotate(0deg); } */
/* 100% { -webkit-transform:rotate(360deg); } */
/* } */
@keyframes spin { 0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); } }
/* social icon custom - kim */
.social-custom-icons { vertical-align: top; }
.social-custom-icons .social-icon-custom { vertical-align: top; display: inline-block; margin: 10px; border-radius: 10px; background: #ddd; color: #fff; text-align: center; padding: 15px; min-width: 50px; min-height: 50px; }
.social-custom-icons .social-icon-custom.sml { font-size: 30px; }
.social-custom-icons .social-icon-custom a, .social-custom-icons .social-icon-custom a:active, .social-custom-icons .social-icon-custom a:visited, .social-custom-icons .social-icon-custom a:hover { color: #fff; }
.social-custom-icons .social-icon-custom a i, .social-custom-icons .social-icon-custom a:active i, .social-custom-icons .social-icon-custom a:visited i, .social-custom-icons .social-icon-custom a:hover i { color: #fff; font-size: 30px; }
.social-custom-icons .social-icon-custom a img, .social-custom-icons .social-icon-custom a:active img, .social-custom-icons .social-icon-custom a:visited img, .social-custom-icons .social-icon-custom a:hover img { width: 30px; height: 30px; }

