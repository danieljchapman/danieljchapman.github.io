.block.block-menu.navigation.menu--main .nav.navbar-nav .nav-item.dropdown:hover .nav-link { color: #f2e1ba; }

/* hiding header form to reduce header size */
.header .navbar .container-lg .navbar-form .region-header-form { display: none; }
.header .navbar .container-lg .navbar-brand img { max-height: 80px; }

