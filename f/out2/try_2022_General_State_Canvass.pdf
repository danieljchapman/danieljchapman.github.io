.social-custom-icons-footer .social-icon-footer a, .social-custom-icons-footer .social-icon-footer a:active, .social-custom-icons-footer .social-icon-footer a:visited, .social-custom-icons-footer .social-icon-footer a:hover { color: #fff; }
