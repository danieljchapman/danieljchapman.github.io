.card { width: 100%; }
.card .card-header, .card .card-body { width: 100%; }
.card .card-header .card-link { width: 100%; }
.card.card-section .card-body .title { color: #192e45; text-align: center; }
.card.card-section .card-body .fa-icon i.fa, .card.card-section .card-body .fa-icon i.fas, .card.card-section .card-body .fa-icon i.far, .card.card-section .card-body .fa-icon img.fa, .card.card-section .card-body .fa-icon img.fas, .card.card-section .card-body .fa-icon img.far { font-size: 50px; width: 55px; }
.card.card-custom-primary .card-header { background: #192e45; color: #fff; padding: 10px 20px; width: 100%; }
.card.card-custom-primary .card-header .card-title { font-size: 1.1rem; }
.card.card-custom-primary .card-header .card-title h4 { font-size: 1.1rem; }
.card.card-custom-primary .card-body { background: #___; }

