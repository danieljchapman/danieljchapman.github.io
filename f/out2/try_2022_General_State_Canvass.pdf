<style type="text/css">
<!--/*--><![CDATA[/* ><!--*/



/*******************************************
This style sheet uses a CSS Compiler/Preprocessor. 
Please see SASS/SCSS files before changing the styles.css.
Arizona Secretary of State Website (Drupal) - Contact Kim Johnson --- kjohnson@azsos.gov
*******************************************/
@import url("https://fonts.googleapis.com/css?family=Prompt|Titillium+Web|Roboto|Questrial|PT+Sans|Muli|Maven+Pro|Krub|KoHo|Exo");
/* @import "bootstrap-grid.scss"; */
/* @import "bootstrap-grid-cols.scss"; */
/* ________________________________________________________________________ */
/** CSS used in all sites, mostly creating new classes or changing some defaults html tags. Not for changing bootstrap drupal classes **/
/* sos red */
/* gold */
/* sky blue */
/* a97e21 */
/* dark navy blue */
/* gold */
/*  */
/* sos red */
/* $color-contact:#757750; */
/* $lib-blue:#56697d;  */
/* $lib-red:#9b5d5d;  */
/* $lib-green:#74836c;  */
/* $lib-gold:#ac8c55;  */
@import url("https://fonts.googleapis.com/css?family=Abel|Alegreya+Sans|Aleo|Amiri|Archivo+Narrow|Arimo|Asap|Barlow|Catamaran|Comfortaa|Crimson+Text|Dosis|Encode+Sans+Condensed|Exo|Exo+2|Fira+Sans|Fira+Sans+Condensed|Fjalla+One|Heebo|Hind+Madurai|Karla|KoHo|Krub|Lato|Libre+Franklin|Lora|Maven+Pro|Montserrat|Mukta|Muli|Nanum+Gothic|Noto+Sans|Noto+Sans+KR|Noto+Sans+TC|Noto+Serif+SC|Nunito|Open+Sans|Open+Sans+Condensed:300|Oswald|PT+Sans|PT+Sans+Narrow|PT+Serif|Playfair+Display|Poppins|Prompt|Questrial|Quicksand|Raleway|Roboto|Rubik|Sarabun|Source+Sans+Pro|Source+Serif+Pro|Teko|Titillium+Web|Ubuntu+Condensed|Pathway+Gothic+One|Anaheim|News+Cycle|Signika");
@import url("https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600&family=Bebas+Neue&family=League+Gothic&family=Oswald&family=Pathway+Gothic+One&family=Sofia+Sans+Extra+Condensed:wght@700&family=Teko:wght@500&display=swap");
.sos_blue { color: #192e45; }

.bg-sos_blue { background: #192e45; color: #fff; }

.border-sos_blue { border: 1px solid #192e45; }

/* This tells me the bootstrap screensize based on the background color of the div */
.bootstrap-test { /* orange */ background: #f90; color: #fff; }

/** HTML tags replace **/
img { border: 0px; }

p { margin: 20px auto; }

div { margin: 1px auto; }

h1, h2, h3, h4, h5, h6 { margin-top: 20px; margin-bottom: 10px; }
h1:first-child, h2:first-child, h3:first-child, h4:first-child, h5:first-child, h6:first-child { margin-top: 10px; }

h7 { background: #192e45; width: 100%; padding: 20px; /* margin-bottom: 20px; */ margin: 20px 0; color: #fff; font-size: 1.3rem; font-weight: bold; display: block; }

.h-style.bottomline { border-bottom: 3px solid; }
.h-style.inline { display: inline-block; }

.list { margin: 20px 10px 20px 50px; }
.list li { margin: 4px auto; }
.list ul, .list ol { margin: 2px auto; }

table { margin: 20px 5px !important; border: 1px solid #ddd; }
table tr th { text-transform: none; }

ul ul, ul ol, ol ul, ol ol { margin-left: 20px; }
ul ul ul, ul ul ol, ul ol ul, ul ol ol, ol ul ul, ol ul ol, ol ol ul, ol ol ol { margin-left: 25px; }

/****** NEW CLASSES ******/
.bold, .bld, b, bold { font-weight: bold; }

.caps { text-transform: capitalize; }

.allcaps, .upper { text-transform: uppercase; }

.smallcaps, .lower { font-variant: small-caps; }

.uline, u, .underln, uline { text-decoration: underline; }

.italics, .ital, i { font-style: oblique; }

s, .strikethrough, .strike { text-decoration: line-through; }

.center, .align_center, .align-center, .acenter { text-align: center; margin: _auto; }

.aleft, .align_left, .align-left { text-align: left; margin: _auto; }

.aright, .align_right, .align-right { text-align: right; margin: _auto; }

.valign-mid { vertical-align: middle; }

.valign-top { vertical-align: top; }

.float_right, .float-right, .fright, .float_left, .float-left, .fleft { margin-top: 5px; }

.float_right, .float-right, .fright { float: right; margin: 0 0px 20px 20px; }

.float_left, .float-left, .fleft { float: left; margin: 0 20px 20px 0px; }

.disabled { color: #333; }

.disabled-lt { color: #666; }

/* --------------------------------------------------------------------------------------*/
.ml20 { margin-left: 20px; }

.ml50 { margin-left: 50px; }

.ml100 { margin-left: 100px; }

.my-10 { margin: 20px auto; }

.frame { padding: 10px; border: 1px solid #333; text-align: center; }
.frame .caption { font-size: .9em; font-style: italic; color: #222; }
.frame.frame-left { text-align: left; }
.frame .caption { font-size: .9em; font-style: italic; color: #222; text-align: left; }

.polaroid { padding: 10px; border: 0px solid #333; box-shadow: 2px 2px 10px #777; margin: 20px auto; text-align: center; }
.polaroid img { text-align: center; }
.polaroid .caption { font-size: .9em; font-style: italic; color: #222; text-align: left; }

.display-hide, .display_hide, .display-none, .display_none, .d-hide, .d-none { display: none; }

.sml-gry { font-size: .9em; color: #333; }

.text-hang, .text_hang { text-indent: -50px; margin-left: 50px; }

.astrick, .asterick, .a-star { font-size: 1.4em; font-weight: bold; }

.reqd, .req { font-size: 1.3em; font-weight: bold; color: #c00; }

.dark-bg { color: #fff; }
.dark-bg a, .dark-bg a:hover, .dark-bg a:active, .dark-bg a:visited { color: #DeB887; }

.quote { text-align: left; background: #f9f9f9; padding: 20px; margin: 10px; font-style: italic; }
.quote.qimg::before, .quote.q-img::before { font-family: FontAwesome; content: "\f10d"; color: #caa451; text-align: left; }
.quote.qimg::after, .quote.q-img::after { font-family: FontAwesome; content: "\f10e"; color: #caa451; text-align: right; }
.quote .phrase { text-align: left; font-style: oblique; }
.quote .phrase.qimg::before, .quote .phrase.q-img::before { font-family: FontAwesome; content: "\f10d"; color: #caa451; text-align: left; margin-right: 10px; }
.quote .phrase.qimg::after, .quote .phrase.q-img::after { font-family: FontAwesome; content: "\f10e"; color: #caa451; text-align: right; margin-left: 10px; }
.quote .author { text-align: right; }

/** style for showing a file type next to the file link **/
.file_item, .file-item, .file_type, .file-type { color: #444; font-size: .9em; }
.file_item.txt, .file_item.text, .file-item.txt, .file-item.text, .file_type.txt, .file_type.text, .file-type.txt, .file-type.text { color: #444; font-size: .9em; }
.file_item.pdf::after, .file-item.pdf::after, .file_type.pdf::after, .file-type.pdf::after { font-family: FontAwesome; content: "\f1c1"; margin-left: 5px; margin-right: 10px; }
.file_item.word::after, .file-item.word::after, .file_type.word::after, .file-type.word::after { font-family: FontAwesome; content: "\f1c2"; margin-left: 5px; margin-right: 10px; }
.file_item.excel::after, .file_item.xcl::after, .file_item.ss::after, .file-item.excel::after, .file-item.xcl::after, .file-item.ss::after, .file_type.excel::after, .file_type.xcl::after, .file_type.ss::after, .file-type.excel::after, .file-type.xcl::after, .file-type.ss::after { font-family: FontAwesome; content: "\f1c3"; margin-left: 5px; margin-right: 10px; }
.file_item.archive::after, .file-item.archive::after, .file_type.archive::after, .file-type.archive::after { font-family: FontAwesome; content: "\f1c6"; margin-left: 5px; margin-right: 10px; }

.padding-10 { padding: 10px !important; }

.kimnotes01 { background: #fc9; }

.language { text-align: right; }
.language .lang { border: 1px solid #caa451; padding: 10px; }

.diff-lang { margin-left: 30px; color: #333; font-size: .95em; border-left: 1px solid #333; padding-left: 10px; }
.diff-lang.desc, .diff-lang.dsc { border: 1px dashed; padding: 10px; }

.lang-sp { margin-left: 30px; color: #333; font-size: .95em; }
.lang-sp.desc, .lang-sp.dsc { border: 1px dashed; padding: 10px; }

/* adjusts images without alt text; alt text needs to be added for accessibility ; search images without alt text */
img:not([alt]) { filter: brightness(40%); border: 2px solid red; padding: 10px; background: red; }

/* this class is just to indicate in Drupal that I don't want an external icon/indicator on this particular type of link  */
/* https://azsos.gov/admin/config/user-interface/extlink */
/* https://azlibrary.gov/admin/config/user-interface/extlink */
/* https://www.arizona.vote/admin/config/user-interface/extlink */
.linktype01 { vertical-align: top; }
.linktype01.sm-2col li { display: inline-block; width: 46%; }
.linktype01.sm-2col li::before { display: inline-block; }

.mgn-btm-20 { margin-bottom: 20px; }

.mgn-btm-40 { margin-bottom: 40px; }

.mgn-btm-50 { margin-bottom: 50px; }

/** This is an alternative to Normal Bootstrap panels. Tanner says this version is more accessible **/
.nobs { width: 100%; /* used in FAQ */ }
.nobs .nobs_collapse { border: 1px solid #ddd; margin: 8px 20px; border-radius: 10px; /* width:100%;  */ }
.nobs .nobs_collapse .nobs_header { background: #ddd; color: #192e45; }
.nobs .nobs_collapse .nobs_header a { margin: 0; color: #192e45; }
.nobs .nobs_collapse .nobs_header a h3 { padding: 10px 15px !important; margin: 0 !important; text-transform: none !important; text-decoration: none !important; color: #192e45; }
.nobs .nobs_collapse .nobs_header a h9 { display: block !important; font-size: 1.1em; padding: 10px 15px !important; margin: 0 !important; text-transform: none !important; text-decoration: none !important; color: #192e45; }
.nobs .nobs_collapse .nobs_header a, .nobs .nobs_collapse .nobs_header a:hover, .nobs .nobs_collapse .nobs_header a:visited, .nobs .nobs_collapse .nobs_header a:active { text-decoration: none; }
.nobs .nobs_collapse .nobs_body { padding: 0px 15px 20px 15px; }
.nobs.covid .nobs_collapse { border: 1px solid #ddd; margin: 8px 20px; border-radius: 10px; }
.nobs.covid .nobs_collapse .nobs_header { background: #ddd; color: #192e45; }
.nobs.covid .nobs_collapse .nobs_body { background: #ddeeff; padding: 0px 15px 20px 15px; }
.nobs._new2022 .nobs_collapse, .nobs.faq2022 .nobs_collapse { border: 0px solid #ddd; margin: 8px 20px; border-radius: 10px; color: #192e45; border-bottom: 1px solid #99a8b9; }
.nobs._new2022 .nobs_collapse .nobs_header, .nobs.faq2022 .nobs_collapse .nobs_header { background: transparent; color: #192e45; border-bottom: 0px solid #aab6c1; border-radius: 10px; margin: 0px auto; }
.nobs._new2022 .nobs_collapse .nobs_header a i.fa, .nobs._new2022 .nobs_collapse .nobs_header a i.fas, .nobs.faq2022 .nobs_collapse .nobs_header a i.fa, .nobs.faq2022 .nobs_collapse .nobs_header a i.fas { margin-right: 15px; }
.nobs._new2022 .nobs_collapse .nobs_header a[aria-expanded="true"], .nobs.faq2022 .nobs_collapse .nobs_header a[aria-expanded="true"] { font-weight: bold; font-size: _93em; background: #FCFCFC; }
.nobs._new2022 .nobs_collapse .nobs_header a[aria-expanded="true"] i.fa-plus, .nobs._new2022 .nobs_collapse .nobs_header a[aria-expanded="true"] i.fa-plus-circle, .nobs._new2022 .nobs_collapse .nobs_header a[aria-expanded="true"] i.fa-check, .nobs.faq2022 .nobs_collapse .nobs_header a[aria-expanded="true"] i.fa-plus, .nobs.faq2022 .nobs_collapse .nobs_header a[aria-expanded="true"] i.fa-plus-circle, .nobs.faq2022 .nobs_collapse .nobs_header a[aria-expanded="true"] i.fa-check { display: none; }
.nobs._new2022 .nobs_collapse .nobs_header a[aria-expanded="false"], .nobs.faq2022 .nobs_collapse .nobs_header a[aria-expanded="false"] { font-weight: normal; color: #1f3955; }
.nobs._new2022 .nobs_collapse .nobs_header a[aria-expanded="false"] i.fa-minus, .nobs._new2022 .nobs_collapse .nobs_header a[aria-expanded="false"] i.fa-minus-circle, .nobs.faq2022 .nobs_collapse .nobs_header a[aria-expanded="false"] i.fa-minus, .nobs.faq2022 .nobs_collapse .nobs_header a[aria-expanded="false"] i.fa-minus-circle { display: none; }
.nobs._new2022 .nobs_collapse .nobs_body, .nobs.faq2022 .nobs_collapse .nobs_body { color: #192e45; }

.nobs.nobs-group-primary .nobs_collapse { background: #fff; margin: 20px 2px; }

/** end nobs **/
/** https://azsos.gov/elections/lobbyists/historical-expenditure-summaries
Historical Expenditure Summaries - https://azsos.gov/node/377 **/
.reports_hes, .report-year, .list-inline-w100 { width: 100px; margin: 6px auto; display: inline-block; }

ul.list-inline-w100, ul.report-year { width: 100%; }
ul.list-inline-w100 li, ul.report-year li { width: 130px; margin: 6px auto; display: inline-block; }

section.pad-tb-20 { padding: 20px 0px 30px 0px; }

.placeholder, .placeholder01, .kimnote01 { color: #555; border: 1px dashed #bbb; padding: 10px; margin: 20px 2px; background: #eee; }
.placeholder .note, .placeholder01 .note, .kimnote01 .note { color: #f60; font: 1.5em 'prompt'; }
.placeholder .note::before, .placeholder01 .note::before, .kimnote01 .note::before { content: "\21d2"; font-size: 1.5em; margin-right: 10px; color: #f93; }
.placeholder .note::after, .placeholder01 .note::after, .kimnote01 .note::after { content: "\21d0 --- Kim"; font-size: 1.5em; margin-left: 10px; color: #f93; }

.d7 { display: none; }

.past-event { color: #777; text-decoration: line-through; }

ul.rules-code-list li { margin: 8px 2px; }

/*


.menu-btn-lrg {
	display:inline-block; width:100%; vertical-align:top; font-size:1.3em; 
	padding:40px 1px;
	background:$sos-blue;
	margin:10px;
	text-align:center;
	height:130px; 
	a {
		padding:40px 1px; width:100%; color:#fff; 
	}
	a:hover,a:visited,a:active {
		color:#fff; 
	}
}


*/
.menu-btn-lrg { display: inline-block; width: 100%; vertical-align: top; font-size: 1.3em; padding: 40px 1px; background: #192e45; margin: 10px; text-align: center; height: 130px; }
.menu-btn-lrg a { padding: 40px 1px; width: 100%; color: #fff; }
.menu-btn-lrg a:hover, .menu-btn-lrg a:visited, .menu-btn-lrg a:active { color: #fff; }

.has-overlay { /* color:#fff;  */ }
.has-overlay a, .has-overlay a:active, .has-overlay a:visited, .has-overlay a:hover { /* color:#fff;  */ }

.bg-overlay { background: rgba(0, 0, 0, 0.5); position: absolute; bottom: 0; left: 0; right: 0; top: 0; z-index: 1; z-index: 0; margin: -1px -2px; opacity: 0.9; }
.bg-overlay.overlay-bg-blue { background: #192e45; /* opacity:0.9; */ }
.bg-overlay.overlay-bg-white { background: #fff; /* opacity:0.9; */ }

.icon { width: 22%; }
.icon i, .icon img { font-size: 30px; width: 30px; }

.wicon { text-align: center; }

/* Buttons with icons on some pages */
.menu-btn-wicon { display: inline-block; width: 99%; vertical-align: top; margin: 4px 1px; padding: 10px 6px; }
