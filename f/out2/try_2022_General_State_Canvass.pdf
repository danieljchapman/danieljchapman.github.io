/*

*/
.edates { border: 1px solid; }
.edates .ta, .edates .th { margin: 8px auto; padding: 8px; border-bottom: 1px dashed #ccc; }
.edates .ta { font-weight: bold; text-align: center; background: #ddd; border-top: 1px solid; }
.edates .th .date, .edates .th .desc { display: inline-block; }
.edates .th .date { width: 30%; }
.edates .th .desc { width: 67%; }

.tbl tbody .pass { color: #666; }
.tbl tbody .ta { text-align: center; font-size: 1.2em; }
.tbl tbody .date, .tbl tbody .desc { padding: 8px auto; }
.tbl tbody .date { width: 25%; padding-left: 10px; }

.custom-bs5-tabs, .lvg2022 { margin-bottom: 50px; }
.custom-bs5-tabs .nav-tabs, .lvg2022 .nav-tabs { border: 0; }
.custom-bs5-tabs .tab-content, .lvg2022 .tab-content { border: 0px solid #dee2e6; border-top: 0; padding: 1px 10px 10px 10px; }

/* subtitle in basic page */
.content .field.field--name-field-subtitle, .node__content .field.field--name-field-subtitle { font: 2.4em 'Roboto'; font-weight: 500; }

.text-formatted ul li::before, .text-formatted ol li::before { display: inline-block !important; }
.text-formatted ul ul, .text-formatted ul ol, .text-formatted ol ul, .text-formatted ol ol { margin-bottom: 0; }
.text-formatted ul ul li::before, .text-formatted ul ol li::before, .text-formatted ol ul li::before, .text-formatted ol ol li::before { display: inline-block !important; }
.text-formatted ul ul ul li::before, .text-formatted ul ul ol li::before, .text-formatted ul ol ul li::before, .text-formatted ul ol ol li::before, .text-formatted ol ul ul li::before, .text-formatted ol ul ol li::before, .text-formatted ol ol ul li::before, .text-formatted ol ol ol li::before { display: inline-block !important; }

/* Reduce spacing between blocks */
/* .node--type-page .layout > [class^="col-"] > * { */
/* margin-bottom: 0 !important; */
/* } */
.node--type-page .layout > [class^="col-"] > * { margin: 0 auto !important; }

/* has pale red/pink background when node isn't published to easily tell if it's not published */
.node--unpublished { background: #EED3D7; }

/* adds radius and top and bottom margin to button class .btn */
.btn { margin: 6px 10px; border-radius: 6px; }

.alert::before { display: none; }

/* Navigation ********************************/
.navbar.navbar-expand-lg .container-lg .navbar-toggler { margin-top: 30px; }

/* move navbar to the right  */
.block-views-exposed-filter-blocksearch-page-1.az-exposed-search.block-search { margin-right: 10px; }

