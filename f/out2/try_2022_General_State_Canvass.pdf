/****** panel-group *******/
.panel-group { width: 95%; /****** new faq 2022 format *******/ }
.panel-group .panel.panel-default { background: #fff; width: 100%; max-width: 1300px; border: 1px solid #ddd; }
.panel-group .panel.panel-default .panel-heading { border: 1px solid #eee; display: block; background: #ddd; padding: 5px 15px; /* font-weight:bold;  */ }
.panel-group .panel.panel-default .panel-heading .panel-title { font-size: 1rem; }
.panel-group .panel.panel-default .panel-heading .panel-title a { width: 100%; display: block; color: #333; }
.panel-group .panel.panel-default .panel-heading .panel-title a:visited, .panel-group .panel.panel-default .panel-heading .panel-title a:active, .panel-group .panel.panel-default .panel-heading .panel-title a:hover { color: #333; }
.panel-group .panel.panel-default .panel-body { background: #fff; padding: 0px 20px 20px 20px; }
.panel-group .panel.panel-default .panel-body .panel-wfa i { color: #444; }
.panel-group.panel-custom-primary .panel.panel-default .panel-heading { background: #192e45; color: #fff; }
.panel-group.panel-custom-primary .panel.panel-default .panel-body .panel-wfa i { color: #192e45; }
.panel-group.panel-group-primary .panel-default { background: #fff; margin: 20px 2px; }
.panel-group.panel-custom-gry .panel.panel-default { border-radius: 5px; }
.panel-group.panel-custom-gry .panel.panel-default .panel-heading { background: #eee; font-weight: none; margin: 0; }
.panel-group.faq2022 .panel.panel-default { background-color: #fff; color: #192e45; border: 0px solid #ddd; margin: 8px 0; border-radius: 10px; border-bottom: 1px solid #99a8b9; }
.panel-group.faq2022 .panel.panel-default .panel-heading { background-color: #fff; color: #192e45; border-bottom: 0px solid #aab6c1; border-radius: 10px; margin: 0px auto; border: 0px; }
.panel-group.faq2022 .panel.panel-default .panel-heading .panel-title { color: #fff; border: 0px; }
.panel-group.faq2022 .panel.panel-default .panel-heading .panel-title a { color: #192e45; font-size: _8em; }
.panel-group.faq2022 .panel.panel-default .panel-heading .panel-title a:visited, .panel-group.faq2022 .panel.panel-default .panel-heading .panel-title a:active, .panel-group.faq2022 .panel.panel-default .panel-heading .panel-title a:hover { color: #192e45; }
.panel-group.faq2022 .panel.panel-default .panel-heading .panel-title a i.fa, .panel-group.faq2022 .panel.panel-default .panel-heading .panel-title a i.fas { margin-right: 15px; display: none; }
.panel-group.faq2022 .panel.panel-default .panel-heading .panel-title a[aria-expanded="true"] { font-weight: bold; font-size: 1.1rem; }
.panel-group.faq2022 .panel.panel-default .panel-heading .panel-title a[aria-expanded="true"] i.fa-minus { display: initial; }
.panel-group.faq2022 .panel.panel-default .panel-heading .panel-title a[aria-expanded="false"] { font-weight: normal; color: #1f3955; font-size: _8em; }
.panel-group.faq2022 .panel.panel-default .panel-heading .panel-title a[aria-expanded="false"] i.fa-plus, .panel-group.faq2022 .panel.panel-default .panel-heading .panel-title a[aria-expanded="false"] i.fa-plus-circle, .panel-group.faq2022 .panel.panel-default .panel-heading .panel-title a[aria-expanded="false"] i.fa-check { display: initial; }
.panel-group.faq2022 .panel.panel-default .panel-body { border-radius: 10px; }
.panel-group.faq2022.misinformation .panel-heading { font-size: 1.4em; }
.panel-group.faq2022.misinformation .fa-check { color: #0c6; }

/* fa icons on the right inside panel */
.panel-wfa i { font-size: 60px; text-align: center; margin-top: 20px; }

