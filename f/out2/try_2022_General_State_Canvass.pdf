.block-block-content { /* max-width:1325px; */ }

.block.block-system.block-system-breadcrumb-block { /* margin:0;  */ }

.slide.slide--0 .paragraph--type--slide .az-slider-content .az-slider-cta { text-align: right; margin-right: 100px; }

.card .card-header { width: 100%; padding: 10px; }
.card .card-header a { width: 100%; text-align: left; padding: 15px; }
.card .card-header .card-link { width: 100%; }
.card .card-body { width: 100%; text-align: left; }
.card .card-footer { width: 100%; }

.card-collapse .card .card-header { width: 100%; }
.card-collapse .card .card-header a { width: 100%; text-align: left; }

/* webform */
/*
*/
/* webform to reactivate on LIVE - 2025 jun 26 - kim johnson */
/* ----------------------------------------------------- */
.row.row-offcanvas .main-content .section .block { /* margin:40px auto;  */ max-width: 1300px; }

/* general site-wide settings for views */
.view { /* view's search filter area throughout site. */ }
.view .view-filters { margin-bottom: 10px; }
.view .view-filters .views-exposed-form .form-row { background: #fff; padding: 20px 20px 20px 20px; }

/* view node details block */
.view-node-details { border: 1px dashed; margin: 10px; padding: 6px; }
.view-node-details.view-display-id-block_1 { background: #ccf; }
.view-node-details.view-display-id-block_2 { border: 0px; font-size: .9em; color: #17294f; padding: 0; margin: 0; }

/* widening the button for files in resources pages.  */
.block-field-blocknoderesourcesfield-resource-documents .content .field.field--name-field-resource-documents div .az-attachment-files { width: 99%; }

/* resource file view */
/* and media */
.block.block-layout-builder.block-field-blockmediadocumentname, .block.block-layout-builder.block-field-blockmediapdf-documentname, .block.block-layout-builder.block-field-blockmediadocument-vrkaname { font-size: 2.3rem; line-height: normal; }
.block.block-layout-builder.block-field-blocknoderesourcesfield-document-type { color: #777; }

.field.field--name-field-document-type { color: #888; }
.field.field--name-field-resource-documents.field--type-entity-reference .contextual-region { width: 99%; }
.field.field--name-field-resource-documents.field--type-entity-reference .contextual-region .az-attachment-files { width: 99%; }
.field.field--name-field-resource-documents.field--type-entity-reference .contextual-region .az-attachment-files .file { width: 100%; max-width: 800px; }

.block-field-blocknodemeetingfield-file .content .field--name-field-file .field__items, .block-field-blocknodemeetingfield-minutes .content .field--name-field-file .field__items { width: 99%; }
.block-field-blocknodemeetingfield-file .content .field--name-field-file .field__items .field__item, .block-field-blocknodemeetingfield-minutes .content .field--name-field-file .field__items .field__item { width: 99%; }
.block-field-blocknodemeetingfield-file .content .field--name-field-file .field__items .field__item .contextual-region .az-attachment-files, .block-field-blocknodemeetingfield-minutes .content .field--name-field-file .field__items .field__item .contextual-region .az-attachment-files { width: 99%; }
.block-field-blocknodemeetingfield-file .content .field--name-field-file .field__items .field__item .contextual-region .az-attachment-files .field--type-file .field__item .file, .block-field-blocknodemeetingfield-minutes .content .field--name-field-file .field__items .field__item .contextual-region .az-attachment-files .field--type-file .field__item .file { width: 99%; max-width: 500px; }

.field__items { width: 99%; }
.field__items .field__item { width: 99%; }
.field__items .field__item .contextual-region .az-attachment-files { width: 99%; }
.field__items .field__item .contextual-region .az-attachment-files .field--type-file .field__item .file { width: 99%; max-width: 500px; }
.field__items .field__item .contextual-region .az-attachment-files .file--application-pdf { width: 99%; }

.az-attachment-files .file { width: 99%; max-width: 500px; }

.node .az-attachment-files .file { /* background-image: none; */ /* padding-left: 0; */ /* white-space: nowrap; */ /* overflow: hidden; */ /* text-overflow: ellipsis; */ /* max-width: 100px; */ width: 99%; max-width: 500px; }

fieldset input { background: #fff; }

/* This is for the area when viewing an agenda from a meeting view.  */
.node--type-page .ui-widget-content { background: #fff; }

.webform-button--submit.button--primary { border: 1px solid #222; background: #ddd; }

/* media nodes margin spacing */
.path-media .main-content .section .field { margin: 15px 0; }

/* Footer styles */
.region-footer-first #block-vieweventscalendar2, .region-footer-first #block-countyelectionscontactinformation { margin-top: 30px; }
.region-footer-first .settings-tray-editable { padding: 5px 30px 5px 20px; margin-top: 5px; }

.region-footer-second #block-az-custom-footerlogo { margin-top: 20px; }

.site-footer .container .row.site-footer__bottom { margin-bottom: 40px; }

/* Agency alert */
.view-alert-block .view-content .views-row { border: 0; }
.view-alert-block .view-content .views-row .node--type-alert.alert-category--emergency { background: #f9e1e5 !important; border-color: #f9e1e5 !important; }
.view-alert-block .view-content .views-row .node--type-alert.alert-category--urgent { background: #FCF9DB !important; border-color: #FCF9DB !important; }
.view-alert-block .view-content .views-row .node--type-alert.alert-category--minor { background: #ebf4df !important; border-color: #ebf4df !important; }
.view-alert-block .view-content .views-row .node--type-alert .close-wrapper { color: #333; }
.view-alert-block .view-content .views-row .node--type-alert .close-wrapper i { color: #333; }
.view-alert-block .view-content .views-row .node--type-alert .content .field--name-field-alert-category { display: none; }
.view-alert-block .view-content .views-row .node--type-alert .content .alert-content { font-size: .9rem; margin: auto 30px !important; color: #333; font-weight: normal !important; }
.view-alert-block .view-content .views-row .node--type-alert .content .alert-content .field--name-field-alert-content { font-weight: normal !important; }

