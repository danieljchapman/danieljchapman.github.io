.panel.panel-default .panel-heading .panel-title { font-size: 1rem; }
.panel.panel-default .panel-heading .panel-title a { width: 100%; display: block; color: #333; }
.panel.panel-default .panel-heading .panel-title a:visited, .panel.panel-default .panel-heading .panel-title a:active, .panel.panel-default .panel-heading .panel-title a:hover { color: #333; }
