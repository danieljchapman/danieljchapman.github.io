/* ________________________________________________________________________ */
/** CSS used to add custom classes to replace drupal or bootstrap classes **/
/* adding borders for all content blocks divs orange */
/* * {border:1px dashed #ddd; } */
/* drupal 9 remove arrows from list and revert to normal list */
.normal-list { list-style: disc !important; }
.normal-list li::before { content: none !important; }

/*__ Modified bootstrap panels -- 2022 Lavidge redesign ______*/
.btn.btn-primary, .btn.btn-secondary { color: #fff; }
.btn.btn-primary a, .btn.btn-primary a:visited, .btn.btn-primary a:active, .btn.btn-primary a:hover, .btn.btn-secondary a, .btn.btn-secondary a:visited, .btn.btn-secondary a:active, .btn.btn-secondary a:hover { color: #fff; }
.btn.btn-primary.col2, .btn.btn-secondary.col2 { width: 100%; margin: 2px 2px 12px 2px; vertical-align: top; }

.btn-set { text-align: center; }

