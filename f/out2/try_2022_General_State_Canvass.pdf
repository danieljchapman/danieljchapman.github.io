.social-custom-icons-footer .social-icon-footer a img, .social-custom-icons-footer .social-icon-footer a:active img, .social-custom-icons-footer .social-icon-footer a:visited img, .social-custom-icons-footer .social-icon-footer a:hover img { width: 18px; vertical-align: middle; }

