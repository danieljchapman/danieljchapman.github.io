/** CSS used to add custom classes to libcal script **/
/* libcal events table */
.s-lc-ea-h3 { display: none; }

.s-lc-ea-tb { width: 98% !important; background: #fff; border: 1px solid #192e45 !important; font-size: 1rem !important; }
.s-lc-ea-tb td { padding: 10px 8px; }
.s-lc-ea-tb .s-lc-ea-ttit { background: #192e45; color: #fff; }
.s-lc-ea-tb .s-lc-ea-ttit a, .s-lc-ea-tb .s-lc-ea-ttit a:active, .s-lc-ea-tb .s-lc-ea-ttit a:visited, .s-lc-ea-tb .s-lc-ea-ttit a:hover { color: #fff; }
.s-lc-ea-tb .s-lc-ea-l, .s-lc-ea-tb .s-lc-ea-tdes, .s-lc-ea-tb .s-lc-ea-tpre, .s-lc-ea-tb .s-lc-ea-to { display: none; }

/** _____________ START MEDIA Breakpoints _______________________________________ **/
/* ________________________________________________________________________ */
/** CSS used in all sites, mostly creating new classes or changing some defaults html tags. Not for changing bootstrap drupal classes **/
/**** @media entries greatest to least __________________________________ */
/*** bootstrap 3 col-md __________________________________ */
@media (max-width: 992px) { .hide-sm, .hide_sm, .hide-tablet, .hide_tablet { display: none; } }
/*** end media 992px __________________________________ */
/*** bootstrap 3 col-sm **/
@media (max-width: 768px) { .hide-sm, .hide_sm, .hide-mobile, .hide_mobile { display: none; } }
/*** end media 768px __________________________________ */
/*** bootstrap 3 col-xs **/
@media (max-width: 576px) { .hide-sm, .hide_sm, .hide-mobile, .hide_mobile { display: none; } }
/*** end media 576px __________________________________ */
/**** @media entries least to greatest __________________________________ */
/*** bootstrap 3 col-sm **/
@media (min-width: 576px) { /* This tells me the bootstrap screensize based on the background color of the div */
  .bootstrap-test { /* yellow */ background: #ff0; color: #000; }
  .bootstrap-test p::before { /* font-family:FontAwesome;  */ content: "Small -"; margin-right: 10px; }
  .icon { width: 42%; }
  .icon i, .icon img { font-size: 50px; width: 50px; }
  .cols-sm-2, .cols-sm-2-all, .cols-count-3 { max-width: 45%; }
  .linktype01.lg-3col li { width: 46%; } }
/*** end media 576px __________________________________ */
/*** bootstrap 3 col-md **/
@media (min-width: 768px) { /* This tells me the bootstrap screensize based on the background color of the div */
  .bootstrap-test { /* green */ background: #66CC00; color: #000; }
  .bootstrap-test p::before { /* font-family:FontAwesome;  */ content: "Medium -"; margin-right: 10px; }
  .my-10 { margin: 60px auto; }
  ul.linktype01 li { width: 46%; margin-right: 5px; display: inline-block; vertical-align: top; /* &::before { */ /* display:inline-block;  */ /* } */ }
  ul.linktype01 li ul li { width: 100%; border: 0; }
  ul.linktype01.lg-3col li, ul.linktype01.cols3 li { width: 31%; }
  ul.linktype01.lg-4col li, ul.linktype01.cols4 li { width: 22%; }
  .linktype01 .link { display: inline-block; vertical-align: top; width: 46%; margin: 10px 1px; }
  .linktype01.cols3 li, .linktype01.cols3 .link { width: 31%; }
  .linktype01.cols4 li, .linktype01.cols4 .link { width: 22%; }
  .menu-btn-lrg { max-width: 44%; }
  .azvote-button.elections { max-width: 170px; }
  .cols-md-2 { max-width: 45%; }
